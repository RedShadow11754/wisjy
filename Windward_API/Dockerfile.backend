FROM python:3.11-slim

WORKDIR /app

# Install system build dependencies for psycopg2 and scientific libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY wind_procurement_model.pkl /app/wind_procurement_model.pkl
COPY workflow.md /app/workflow.md
COPY data /app/data
COPY backend /app/backend

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Seed the database, then launch Uvicorn. Honours $PORT because hosted platforms
# (Render, Railway, Fly, Cloud Run) inject the port the router forwards to;
# falls back to 8000 for local `docker compose up`.
CMD ["sh", "-c", "python3 -m backend.db.seed_db && uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
